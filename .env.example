# Built-in storage adapter.
STORAGE_DRIVER=postgres
DATABASE_URL=postgresql://chopin:chopin@127.0.0.1:5432/chopin?sslmode=disable

# Hosted planner defaults.
AGENT=on
# copilot (user entitlement) or anthropic (deployment API key).
AGENT_PROVIDER=copilot
# Leave blank for the provider default: claude-sonnet-4.6 / claude-fable-5-1.
MODEL=
# Required only for AGENT_PROVIDER=anthropic. Keep production keys in a secret manager.
ANTHROPIC_API_KEY=
BACKGROUND_JOBS=on
WEB_RESEARCH=on

# GitHub App sign-in.
# Remote VM mode overrides this local origin in child processes; see docs/exe-dev.md.
APP_ORIGIN=http://127.0.0.1:8787
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Optional comma-separated GitHub logins. The lists are combined; leave both
# empty to admit every authenticated GitHub user.
GITHUB_ALLOWED_USERS=
GITHUB_ALLOWED_ORGANIZATIONS=
# Encrypts only the short-lived OAuth state and PKCE cookie.
# Generate it with `openssl rand -hex 32`.
SESSION_ENCRYPTION_KEY=
